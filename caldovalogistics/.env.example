# Use the primary endpoint for writes and consistency-sensitive reads.
WRITE_DATABASE_URL=host=<primary-endpoint> port=5432 dbname=postgres user=<user> password=<password> sslmode=require

# Use the reader endpoint for dashboards, tracking, and knowledge retrieval.
READ_DATABASE_URL=host=<reader-endpoint> port=5432 dbname=postgres user=<user> password=<password> sslmode=require

APP_PORT=8010
